# Copy this file to .env and fill in only the values you need.
# Never commit .env or real credentials.

# LLM configuration (local Ollama is the default)
JARL_LLM_PROVIDER=ollama
JARL_LLM_MODEL=qwen2.5:7b
JARL_LLM_BASE_URL=http://127.0.0.1:11434
# JARL_LLM_API_KEY=
# DEEPSEEK_API_KEY=
# JARL_LLM_CONFIG=
# JARL_LLM_TEMPERATURE=0.0

# Experiment and agentic-case workspaces
JARL_EXPERIMENTS_ROOT=results/dags
JARL_CASES_ROOT=results/cases
# JARL_ENV_LOCK_FILE=
# LLM_MODELS_DIR=

# Optional Weights & Biases tracking
WANDB_MODE=offline
# WANDB_API_KEY=
# WANDB_ENTITY=
# WANDB_PROJECT=jarl

# MCP server
JARL_MCP_EXPERIMENT_DIR=results/cmp/jarl
PYTHONUNBUFFERED=1
